# انسخ هذا الملف إلى .env وضع قيمك
BOT_TOKEN=ضع_توكن_البوت_هنا

# الوضع الافتراضي: Polling (يعمل على أي استضافة بدون دومين)
USE_WEBHOOK=false

# عند تفعيل Webhook (مطلوب دومين HTTPS):
# WEBHOOK_URL=https://your-domain.com
# WEBHOOK_SECRET=
# PORT=8080

# مجلد حفظ قاعدة البيانات والملفات (اختياري)
# DATA_DIR=./data
